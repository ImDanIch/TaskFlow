{
  "description": "TaskFlow-KB path policies; review and trust before enabling.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__taskflow_kb__.*$",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/TaskFlow/.venv/Scripts/python.exe C:/Users/user/TaskFlow/guardrails/codex_hook.py",
            "timeout": 10,
            "statusMessage": "Checking TaskFlow-KB policy"
          }
        ]
      }
    ]
  }
}
